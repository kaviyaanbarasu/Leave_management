PROJECT_NAME="Dynamic PTO & Leave Management System"
API_V1_STR="/api"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:root@localhost:5432/leave_management_db"

# Google Calendar API Key (for real-time public holiday synchronization)
GOOGLE_CALENDAR_API_KEY=""

# Gmail SMTP Email Notification Configuration
# System Sender: leavemanagamentsystem45@gmail.com
# For Gmail: Use smtp.gmail.com on port 587 with STARTTLS.
# Use a 16-character Google App Password (generated in Google Account Security -> 2-Step Verification -> App Passwords).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=leavemanagamentsystem45@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=leavemanagamentsystem45@gmail.com
MAIL_FROM_NAME=Leave Management System

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]